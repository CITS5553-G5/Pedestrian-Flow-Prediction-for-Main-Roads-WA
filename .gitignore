# Reviewed building feature workbooks remain versioned under 06_outputs/.
data/external_raw/microsoft_building_footprints/*/australia_tiles/*.csv.gz
data/external_raw/microsoft_building_footprints/*/dataset-links.csv
data/external_raw/pta_stops/*
