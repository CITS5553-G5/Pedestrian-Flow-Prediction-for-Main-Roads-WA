# Runtime API configuration
#
# Copy this file to `.env`, add the required key, and run the Python command
# again. Changing provider, model, or API key does NOT require rebuilding the
# development container.

# Street-level imagery source used by the current prototype.
MAPILLARY_ACCESS_TOKEN=

# Google Maps Platform credential used only by the Places Aggregate POI
# feature-extraction notebook. This is not the Gemini API key.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Active vision provider
# ---------------------------------------------------------------------------
# Supported configuration names:
#   gemini, openai, claude, grok, deepseek, glm, kimi
#
# `auto` selects the project's tested default model for that provider. Set an
# explicit model ID only when a different model has been tested with image input
# and the project's structured output schema.
VISION_PROVIDER=gemini
VISION_MODEL=auto

# ---------------------------------------------------------------------------
# Active test provider: Google Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Optional providers - leave commented out until the client chooses one
# ---------------------------------------------------------------------------
# To switch provider:
#   1. Change VISION_PROVIDER above.
#   2. Uncomment and fill only that provider's key below.
#   3. Leave VISION_MODEL=auto, or enter a tested model ID.
#   4. Restart the Python command. Do not rebuild the container.

# OpenAI
# OPENAI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# xAI Grok
# XAI_API_KEY=

# DeepSeek
# Reserved in the configuration registry. Do not select it for the imagery
# pipeline until its official API supports and passes the image-input test.
# DEEPSEEK_API_KEY=

# Zhipu GLM
# ZAI_API_KEY=

# Moonshot Kimi
# MOONSHOT_API_KEY=

# Provider API protocols and official base URLs are maintained inside the
# Python provider registry. Clients do not need to enter them here.
